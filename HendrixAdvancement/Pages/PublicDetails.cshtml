@page
@model HendrixAdvancement.Pages_Projects.PublicDetailsModel

@{
    ViewData["Title"] = "Details";
}

<head>
    <img id="HDX" src="~/images/hendrixLogo_bob.svg" alt="Hendrix Logo" width="300px">
        <link
        href="https://fonts.googleapis.com/css2?family=Iceberg&family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&family=Macondo&display=swap"
        rel="stylesheet" />
        <link rel="stylesheet" href="Index.cshtml.css" />
        <h1>@Html.DisplayFor(model => model.Project.Title)</h1>
        <hr class="hr" />
    </head>

    <body>
        <div class="container">
            <div class="row">
                <dd class="col-6">
                    @Html.DisplayFor(model => model.Project.Description)
                    <div class="row">
                        <dl class="row">
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Location)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Location)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Department)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Department)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Category)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Category)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Timeframe)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Timeframe)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Funded)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Funded)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Project.Cost)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Project.Cost)
                            </dd>
                        </dl>
                    </div>
                </dd>
                <dd class="col-6"><img id="Image" src="@Model.Project.Image" alt="Image" width="500px">
                </dd>
            </div>
    
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                     style="width:@((Model.Project.Funded / Model.Project.Cost) * 100)%"
                     aria-valuenow="@((Model.Project.Funded / Model.Project.Cost) * 100)" aria-valuemin="0"
                     aria-valuemax="100">@Html.DisplayFor(model => model.Project.Funded) / @Html.DisplayFor(model =>
                                                                                                                                                                                                                                                                                                                                                                                    model.Project.Cost)</div>
                </div>
            </div>

            <div>
                <h1 style="padding-top: 3%">Opportunities</h1>
                <hr class="hr" />
                <dd class="col-sm-10">
                    <table class="table">
                        <tr>
                            <th id="headings">Title</th>
                            <th id="headings">Description</th>
                            <th id="headings">Funded</th>
                            <th id="headings">Cost</th>
                        </tr>
                        @foreach (var item in Model.Project.Opportunities)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Title)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Funded)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Cost)
                                </td>
                                <td>
                                    <a asp-page="/PublicDetailsOpp" asp-route-id="@item.OpportunityId">Details</a>
                                </td>
                            </tr>
                        }
                    </table>
                </dd>
            </div>

            <div>
                <a asp-page="/Index">Back to Home Page</a>
            </div>

        </div>
    </body>

