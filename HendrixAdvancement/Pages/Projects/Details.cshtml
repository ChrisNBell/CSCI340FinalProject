@page
@model HendrixAdvancement.Pages_Projects.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<head>
    <img id="HDX" src="~/images/hendrixLogo_bob.svg" alt="Hendrix Logo" width="300px">
        <link
        href="https://fonts.googleapis.com/css2?family=Iceberg&family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&family=Macondo&display=swap"
        rel="stylesheet" />
        <h1>Projects Database: Details</h1>
        <hr class="hr" />
        <link rel="stylesheet" href="Index.cshtml.css" />

    </head>

    <div>
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Title)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Title)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Description)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Location)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Location)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Department)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Department)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Category)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Category)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Timeframe)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Timeframe)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Funded)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Funded)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Cost)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Cost)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Project.Image)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Project.Image)
            </dd>
            <dd class="col-sm-10">
                <p>
                    <a style="color: #CB4F0C;" asp-page="/Opportunities/Create">Create New Opportunity</a>
                </p>
                <table class="table">
                    <tr>
                        <th id="headings">Title</th>
                        <th id="headings">Description</th>
                        <th id="headings">Priority</th>
                        <th id="headings">Status</th>
                        <th id="headings">Funded</th>
                        <th id="headings">Cost</th>
                        <th id="headings">Image</th>
                    </tr>
                    @foreach (var item in Model.Project.Opportunities)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Priority)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Funded)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Cost)
                            </td>
                            <td>
                                <img id="Image" src="@item.Image" alt="Image" width="50px">
                            </td>
                            <td>
                                <a asp-page="/Opportunities/Edit" asp-route-id="@item.OpportunityId">Edit</a> |
                                <a asp-page="/Opportunities/Details" asp-route-id="@item.OpportunityId">Details</a> |
                                <a asp-page="/Opportunities/Delete" asp-route-id="@item.OpportunityId">Delete</a>
                            </td>
                        </tr>
                    }
                </table>
            </dd>
        </dl>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Project.ProjectId">Edit</a> |
        <a asp-page="./Index">Back to List</a>
    </div>
