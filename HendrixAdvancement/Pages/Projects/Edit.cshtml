@page
@model HendrixAdvancement.Pages_Projects.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Project</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Project.ProjectId" />
            <div class="form-group">
                <label asp-for="Project.Title" class="control-label"></label>
                <input asp-for="Project.Title" class="form-control" />
                <span asp-validation-for="Project.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Description" class="control-label"></label>
                <input asp-for="Project.Description" class="form-control" />
                <span asp-validation-for="Project.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Location" class="control-label"></label>
                <input asp-for="Project.Location" class="form-control" />
                <span asp-validation-for="Project.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Department" class="control-label"></label>
                <input asp-for="Project.Department" class="form-control" />
                <span asp-validation-for="Project.Department" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Category" class="control-label"></label>
                <input asp-for="Project.Category" class="form-control" />
                <span asp-validation-for="Project.Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Timeframe" class="control-label"></label>
                <input asp-for="Project.Timeframe" class="form-control" />
                <span asp-validation-for="Project.Timeframe" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Cost" class="control-label"></label>
                <input asp-for="Project.Cost" class="form-control" />
                <span asp-validation-for="Project.Cost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
