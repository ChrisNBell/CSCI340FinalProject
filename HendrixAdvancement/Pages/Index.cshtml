@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<html>

<head>
    <img id="HDX" src="~/images/hendrixLogo_bob.svg" alt="Hendrix Logo" width="300px">
        <link
        href="https://fonts.googleapis.com/css2?family=Iceberg&family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&family=Macondo&display=swap"
        rel="stylesheet" />
        <h1>Hendrix Advancement: Project Listings</h1>
        <hr class="hr" />
    </head>

    <body>

        <section class="container">
            <div class="row">
                <div class="col-6">
                    <h2>GIVE TO HENDRIX</h2>

                    <p>
                        The residential liberal arts experience at Hendrix has transformed the lives of generations of
                        Hendrix
                        alumni.
                        Your
                        giving helps to ensure it remains accessible and affordable for future students. Below are project
                        listings
                        that
                        are
                        designed to benefit students and faculty on campus. Each project listing contains basic information
                        about
                        the
                        project.
                        If you would like to learn more about a specific project to see if it is the right fit for you,
                        click on
                        the
                        unique
                        link
                        on the far right! Our purpose is to provide our students with the best experience here at Hendrix
                        College,
                        and
                        you
                        have
                        the opportunity to help make this possible!
                    </p>
                </div>

                <div class="col d-flex align-items-center">
                    <img id="gift" src="~/images/Gift.png" alt="Make A Gift" class="img-fluid" width="650px">
                    </div>
                </div>
            </section>

            <table class="table">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Title)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Location)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Department)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Category)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Timeframe)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Cost)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Project[0].Approval)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Project)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Location)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Department)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Category)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Timeframe)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Cost)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Approval)
                            </td>
                            <td>
                                <a asp-page="./Details" asp-route-id="@item.ProjectId">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </body>

    </html>
   