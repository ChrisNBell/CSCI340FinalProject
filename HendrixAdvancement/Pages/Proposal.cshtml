@page
@model ProposalModel
@{
    ViewData["Title"] = "Propose a Project";
}
<h1>
<img id="HDX" src="~/images/hendrixLogo_bob.svg" alt="Hendrix Logo" width="300px">
    <link
    href="https://fonts.googleapis.com/css2?family=Iceberg&family=Libre+Baskerville:ital,wght@0,400..700;1,400..700&family=Macondo&display=swap"
    rel="stylesheet" />
    <h1>Hendrix Advancement: Project Proposal Page</h1>
    <hr class="hr" />
</h1>

<h2>Have a Project That You Want To Propose?</h2>
<p>We welcome any Faculty and Staff who have an idea or a current project that could have potential funding needs to submit the project 
    proposal form below. All we need is some information about the project, then, upon approval, your project will be available on the 
    Advancement website and available to potential doners.
</p>


<form>
    <p><label for="fname">First name:</label><br>
    <input type="text" id="fname" name="fname"><br></p>

    <p><label for="lname">Last name:</label><br>
    <input type="text" id="lname" name="lname"></p>
  
    <p>Are you a member of the Hendrix Faculty?</p>
    <p><input type="checkbox" id="yfaculty" name="yfaculty" value="yes">
    <label for="yfaculty"> Yes</label><br>
    <input type="checkbox" id="nfaculty" name="nfaculty" value="no">
    <label for="nfaculty"> No</label><br></p>

    <p><label for="title">Title of the project</label><br>
    <input type="text" id="title" name="title"><br></p>

    <p><label for="description">Please give a brief description of the project</label><br>
    <input type="text" id="description" name="description"></p>

    <p><label for="location">Where is your project located?</label><br>
    <input type="text" id="location" name="location"><br></p>

    <p><label for="department">What department is your project in?</label><br>
    <input type="text" id="department" name="department"></p>

    <p>What category is your project?</p>
    <p><input type="radio" id="cat1" name="cat1" value="First category">
    <label for="cat1">First category</label><br>
    <input type="radio" id="cat2" name="cat2" value="Second category">
    <label for="cat2">Second category</label><br>
    <input type="radio" id="cat3" name="cat3" value="Third category">
    <label for="cat3">Third category</label><br></p>


    <p><label for="time">What is the time frame of this project?</label><br>
    <input type="text" id="time" name="time"></p>

    <p><label for="cost">How much funding is needed?</label><br>
    <input type="text" id="cost" name="cost"></p>

    <p><label for="nameable">Are there any doner naming opportunities?</label><br>
    <input type="text" id="nameable" name="nameable"></p>

    <p><input type="submit" value="Submit"></p>
</form>



<h4>Have Questions About This Process?</h4>
<p>
<ul style="list-style-type:circle;">
    <li><a class="nav-link" asp-area="" asp-page="/About">Click Here</a></li> 
    <li> or click on the about tab to contact the Advancement Office</li>
</ul>
</p>


