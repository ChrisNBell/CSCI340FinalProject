@page
@model HendrixAdvancement.Pages.Opportunities.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Project)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Cost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opportunity[0].Nameable)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Opportunity) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Project.ProjectId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Priority)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nameable)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.OpportunityId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.OpportunityId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.OpportunityId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
